Route::middleware(['auth', 'role:chu_tro'])
    ->prefix('chu-tro')
    ->name('chutro.')
    ->group(function () {
        Route::resource('phong', PhongController::class)->except('show');
        Route::delete('anh-phong/{anhPhong}', [PhongController::class, 'xoaAnh'])->name('phong.xoa-anh');
    });
